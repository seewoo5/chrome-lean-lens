{
  "manifest_version": 3,
  "name": "Lean Lens: Lean 4 Hover Inspector for GitHub",
  "version": "1.3.0",
  "description": "Hover over Lean 4 code on GitHub to see types, docstrings and tactic docs, or Lean's own hovers, proof states and infoview via a local helper.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lean Lens"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content/builtins_db.js",
        "content/lean_tokenizer.js",
        "content/lean_terms.js",
        "content/binder_context.js",
        "content/term_hover.js",
        "content/pr_scanner.js",
        "content/goal_diff.js",
        "content/tooltip_view.js",
        "content/outline_panel.js",
        "content/infoview_panel.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://loogle.lean-lang.org/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://leanprover-community.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "infoview/host.html",
        "infoview/frame.html"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "sandbox": {
    "pages": [
      "infoview/frame.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'none'"
  }
}
